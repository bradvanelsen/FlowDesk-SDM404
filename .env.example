# Supabase (frontend auth). Copy this file to .env.local and fill in the anon key.
# The anon/publishable key is browser-safe, but real keys must NOT be committed —
# .env.local is gitignored. This .env.example is safe to commit (no secret value).
VITE_SUPABASE_URL=https://tqkyghashkawgqbnrwaf.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# FastAPI backend (Fly.io). Public base URL — not a secret.
VITE_API_BASE_URL=https://flowdesk-backend.fly.dev/api/v1
